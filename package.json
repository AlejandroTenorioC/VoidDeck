{
  "name": "void-deck",
  "version": "0.1.1",
  "description": "Void Deck: an interface of dots, light, and void for the Steam Deck.",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c -w",
    "typecheck": "tsc --noEmit",
    "preview": "node preview/server.mjs",
    "deck": "node scripts/deploy.mjs",
    "deck:setup": "node scripts/deck-setup.mjs",
    "deck:log": "node scripts/deck-log.mjs",
    "package": "node scripts/package.mjs"
  },
  "devDependencies": {
    "@decky/rollup": "^1.0.2",
    "@decky/ui": "~4.12.1",
    "@fontsource/doto": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@fontsource/space-mono": "^5.3.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "esbuild": "^0.28.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "rollup": "^4.64.6",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@decky/api": "^1.1.3",
    "tslib": "^2.8.1"
  },
  "license": "GPL-3.0-only",
  "packageManager": "pnpm@12.11.2",
  "repository": {
    "type": "git",
