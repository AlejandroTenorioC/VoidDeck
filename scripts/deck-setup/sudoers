# Void Deck: development commands allowed without a password. Installed in /etc/sudoers.d/zz-voiddeck (after wheel).
deck ALL=(root) NOPASSWD: /etc/voiddeck/deploy.sh
deck ALL=(root) NOPASSWD: /usr/bin/systemctl start plugin_loader, /usr/bin/systemctl stop plugin_loader, /usr/bin/systemctl restart plugin_loader
